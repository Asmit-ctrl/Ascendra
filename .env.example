# ═══════════════════════════════════════════════════════════════════════════
# SYNCSENTA CONFIGURATION TEMPLATE
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values

# ─── AI Services (REQUIRED) ──────────────────────────────────────────────────
# Primary: Groq (fastest, free tier with rate limits)
# Get your free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Secondary: OpenRouter (fallback when Groq is rate-limited)
# Get your API key: https://openrouter.ai/keys
# Free tier: 200 requests/day, then pay-as-you-go
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Legacy provider setting (kept for compatibility)
LLM_PROVIDER=groq

# Optional: Backup Groq keys for rotation
# GROQ_API_KEY_2=your_backup_key_1
# GROQ_API_KEY_3=your_backup_key_2

# ─── Frontend URLs ───────────────────────────────────────────────────────────
# Local development
# NEXT_PUBLIC_AI_AGENTS_URL=http://localhost:8001

# Production (Render deployment)
NEXT_PUBLIC_AI_AGENTS_URL=https://ascendra-1.onrender.com

# ─── Development ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ─── Optional: Database (for future features) ────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/syncsenta
# REDIS_URL=redis://127.0.0.1:6379
