{
  "version": 2,
  "name": "syncsenta",
  "builds": [
    {
      "src": "studio/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "ai-agents/src/syncsenta_agents/api/server.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/agents/(.*)",
      "dest": "ai-agents/src/syncsenta_agents/api/server.py"
    },
    {
      "src": "/(.*)",
      "dest": "studio/$1"
    }
  ],
  "env": {
    "GROQ_API_KEY": "@groq_api_key",
    "GROQ_MODEL": "llama-3.3-70b-versatile",
    "LLM_PROVIDER": "groq",
    "ENVIRONMENT": "production"
  },
  "build": {
    "env": {
      "GROQ_API_KEY": "@groq_api_key"
    }
  }
}
