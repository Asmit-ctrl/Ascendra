# SyncSenta AI Agents Configuration

# Environment
ENVIRONMENT=development
DEBUG=true

# LLM Provider Selection
# Options: ollama, groq, dify
LLM_PROVIDER=groq

# Groq Configuration (RECOMMENDED - FREE & FAST)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile  # or mixtral-8x7b-32768, gemma2-9b-it

# Ollama Configuration (local, requires GPU)
OLLAMA_BASE_URL=http://localhost:11434

# Dify Configuration (alternative cloud option)
DIFY_API_KEY=your_dify_api_key_here
DIFY_BASE_URL=https://api.dify.ai/v1

# Stellar Blockchain
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SCHOOL_SECRET_KEY=your_stellar_secret_key_here

# Database
DATABASE_URL=sqlite:///./syncsenta_agents.db
COUCHDB_URL=http://localhost:5984

# Voice and Multimodal
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
WHISPER_MODEL=base

# Performance
MAX_CONCURRENT_REQUESTS=1000
REQUEST_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=300

# Cultural Settings
DEFAULT_LANGUAGE=english
CULTURAL_CONTEXT=kenyan