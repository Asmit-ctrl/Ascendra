# ──────────────────────────────────────────────────────────────────────
# Studio environment configuration
#
# Copy to .env.local for development. Set these in the Vercel project
# Environment Variables panel for production.
# ──────────────────────────────────────────────────────────────────────

# Server-side ONLY. Never expose to the client. Used by /api/chat.
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional override. Default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Public — used by the legacy teacher-side AI generators (lesson plan,
# assessment, scheme of work, agent stats). Points to the FastAPI service
# in ai-agents/, currently deployed on Render. Safe to leave at default
# for prod; set to http://localhost:8001 for local backend work.
# Student chat does NOT use this; it talks to /api/chat directly.
NEXT_PUBLIC_AI_AGENTS_URL=https://ascendra-1.onrender.com
